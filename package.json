{
  "name": "gnester",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"config/**/*.{ts,yml,yaml}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"README.md\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"config/**/*.{ts,yml,yaml}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"README.md\" \"*.json\"",
    "start": "NODE_ENV=development nest start",
    "start:gateway": "NODE_ENV=development nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main",
    "start:demo-service": "NODE_ENV=development nest start --entryFile processes/demo-greeting-service.main",
    "start:demo-service:dev": "NODE_ENV=development nest start --watch --entryFile processes/demo-greeting-service.main",
    "start:demo-service:prod": "NODE_ENV=production node dist/src/processes/demo-greeting-service.main",
    "lint": "eslint \"{src,apps,libs,test,config}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test,config}/**/*.ts\"",
    "typecheck": "tsc --project tsconfig.build.json --noEmit --incremental false",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:artifact": "node scripts/verify-build-artifact.mjs",
    "verify:demo-service-start": "node scripts/run-with-nats-server.mjs node scripts/verify-demo-service-start.mjs",
    "typeorm": "typeorm-ts-node-commonjs -d config/typeorm.data-source.ts",
    "migration:create": "typeorm migration:create",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "typeorm:secondary": "typeorm-ts-node-commonjs -d config/typeorm.secondary-data-source.ts",
    "migration:secondary:generate": "pnpm typeorm:secondary migration:generate",
    "migration:secondary:run": "pnpm typeorm:secondary migration:run",
    "migration:secondary:revert": "pnpm typeorm:secondary migration:revert",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:cov": "NODE_ENV=test jest --coverage",
    "test:debug": "NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test node scripts/run-with-nats-server.mjs node node_modules/jest/bin/jest.js --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/typeorm": "^11.0.1",
    "bullmq": "^5.73.2",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cron": "^4.4.0",
    "js-yaml": "^5.2.3",
    "mongoose": "^9.6.2",
    "mysql2": "^3.20.0",
    "nats": "^2.29.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.19",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1"
  },
  "jest": {
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/config"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^config/(.*)$": "<rootDir>/config/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@11.1.2"
}
