NODE_ENV=production

PORT=3000

# Database
ENABLE_MULTI_DATABASE=false

# Primary database
PRIMARY_DB_TYPE=mysql
PRIMARY_DB_HOST=localhost
PRIMARY_DB_PORT=3306
PRIMARY_DB_USERNAME=root
PRIMARY_DB_PASSWORD=123456
PRIMARY_DB_DATABASE=pro
PRIMARY_DB_SYNCHRONIZE=false
PRIMARY_DB_AUTO_LOAD_ENTITIES=true
PRIMARY_DB_RETRY_ATTEMPTS=10
PRIMARY_DB_RETRY_DELAY=3000

# Secondary database, enable with ENABLE_MULTI_DATABASE=true
# SECONDARY_DB_TYPE=mysql
# SECONDARY_DB_HOST=localhost
# SECONDARY_DB_PORT=3306
# SECONDARY_DB_USERNAME=root
# SECONDARY_DB_PASSWORD=123456
# SECONDARY_DB_DATABASE=pro_secondary
# SECONDARY_DB_SYNCHRONIZE=false
# SECONDARY_DB_AUTO_LOAD_ENTITIES=true
# SECONDARY_DB_RETRY_ATTEMPTS=10
# SECONDARY_DB_RETRY_DELAY=3000

# Redis
REDIS_URL=redis://localhost:6379
