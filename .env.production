NODE_ENV=production

PORT=3000

# NATS and Demo greeting microservice
NATS_SERVERS=nats://nats:4222
NATS_CONNECTION_TIMEOUT_MS=2000
DEMO_GREETING_NATS_QUEUE_GROUP=gnester.demo-greeting.v1
DEMO_GREETING_NATS_GRACE_PERIOD_MS=5000
DEMO_GREETING_REQUEST_TIMEOUT_MS=3000

# Primary database
PRIMARY_DB_TYPE=mysql
PRIMARY_DB_HOST=localhost
PRIMARY_DB_PORT=3306
PRIMARY_DB_USERNAME=root
PRIMARY_DB_PASSWORD=123456
PRIMARY_DB_DATABASE=pro
PRIMARY_DB_SYNCHRONIZE=false
PRIMARY_DB_AUTO_LOAD_ENTITIES=true
PRIMARY_DB_RETRY_ATTEMPTS=10
PRIMARY_DB_RETRY_DELAY=3000

# Secondary database
# SECONDARY_DB_TYPE=mysql
# SECONDARY_DB_HOST=localhost
# SECONDARY_DB_PORT=3306
# SECONDARY_DB_USERNAME=root
# SECONDARY_DB_PASSWORD=123456
# SECONDARY_DB_DATABASE=pro_secondary
# SECONDARY_DB_SYNCHRONIZE=false
# SECONDARY_DB_AUTO_LOAD_ENTITIES=true
# SECONDARY_DB_RETRY_ATTEMPTS=10
# SECONDARY_DB_RETRY_DELAY=3000

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=gnester_pro
MONGO_AUTO_CREATE=false
MONGO_RETRY_ATTEMPTS=10
MONGO_RETRY_DELAY=3000

# Secondary MongoDB
# SECONDARY_MONGO_URI=mongodb://localhost:27017
# SECONDARY_MONGO_DATABASE=gnester_pro_audit
# SECONDARY_MONGO_AUTO_CREATE=false
# SECONDARY_MONGO_RETRY_ATTEMPTS=10
# SECONDARY_MONGO_RETRY_DELAY=3000

# Redis
REDIS_URL=redis://localhost:6379
